<?xml version="1.0" encoding="utf-8"?>
<!--
  Release builds: HTTPS only (Android's secure default; no overrides here).
  Debug builds reference this via the debug manifest to permit CLEARTEXT to the
  loopback host and the Android-emulator host (10.0.2.2) so the app can reach
  local Firebase emulators. Production traffic to Firebase is always TLS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
