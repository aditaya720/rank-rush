<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The Dart VM service and Flutter debugger need INTERNET on debug builds.
         Cleartext is enabled only in debug so the app can reach local Firebase
         emulators over http (see res/xml/network_security_config.xml). -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"/>
</manifest>
