# ---------------------------------------------------------------------------
# Rank Rush — environment configuration EXAMPLE
# ---------------------------------------------------------------------------
# This game uses VIRTUAL COINS ONLY. There are no real-money keys of any kind
# (no payment gateway, no UPI, no crypto) — and there never should be.
#
# Copy this file to `dart_defines.json` (see dart_defines.example.json) OR pass
# the values with --dart-define at build/run time. NEVER commit real values.
# NEVER place server private keys / service-account credentials in the Flutter
# client. Those belong only in the Cloud Functions runtime.
# ---------------------------------------------------------------------------

# Firebase project (used by flutterfire configure -> lib/firebase_options.dart)
FIREBASE_PROJECT_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=

# Region where Cloud Functions are deployed (must match functions/src/index.ts)
FUNCTIONS_REGION=us-central1

# The single logical game table clients join (see functions createRound).
GAME_ID=main

# Optional: base URL if you also expose an HTTPS gateway. Callable functions do
# not need this; kept for parity with deployments that add a REST edge.
BACKEND_BASE_URL=

# App Check provider debug token (DEBUG builds only; never ship a real token).
APP_CHECK_DEBUG_TOKEN=

# Crash reporting DSN (only if you wire an additional Sentry sink; Crashlytics
# is configured through firebase_options.dart and needs no DSN here).
SENTRY_DSN=
